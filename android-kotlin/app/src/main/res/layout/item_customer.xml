<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/line">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_nama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Pelanggan"
            android:textStyle="bold"
            android:textColor="@color/color_meter"
            android:textSize="15sp" />
            
        <TextView
            android:id="@+id/tv_idpel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="IDPEL: 12345678"
            android:textColor="@color/ink"
            android:textSize="12sp" />
            
        <TextView
            android:id="@+id/tv_nometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No. Meter: -"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_alamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Alamat: -"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_stlalu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="St Lalu: -"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="Buka Scan Meter"
            app:icon="@drawable/ic_campaign"
            app:iconGravity="textStart"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:textColor="@color/surface"
            app:backgroundTint="@color/color_meter" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

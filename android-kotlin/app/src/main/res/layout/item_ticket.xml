<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/line">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_build"
                app:tint="@color/color_perbaikan"
                android:layout_marginEnd="8dp" />
                
            <TextView
                android:id="@+id/tv_ticket_no"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RP-12345"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:textSize="14sp" />
                
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPEN"
                android:textStyle="bold"
                android:textColor="@color/danger"
                android:background="@drawable/bg_version_badge"
                android:backgroundTint="#26EF4444"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_nama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Pelanggan"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/color_perbaikan" />
            
        <TextView
            android:id="@+id/tv_idpel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ID: 12345678"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_alamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Alamat Pelanggan"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="@color/canvas"
            android:padding="10dp">
            
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_campaign"
                app:tint="@color/muted"
                android:layout_marginEnd="8dp" />
                
            <TextView
                android:id="@+id/tv_kendala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keluhan / Kendala"
                android:textColor="@color/ink"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
